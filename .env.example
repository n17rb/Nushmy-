# ===== نشمي — متغيرات البيئة =====
# انسخ هذا الملف باسم .env وعدّل القيم

# منفذ الخادم
PORT=3000

# بيئة التشغيل: development أو production
NODE_ENV=development

# مفتاح توقيع الجلسات — غيّره لقيمة عشوائية طويلة قبل النشر
# لتوليد قيمة:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-before-production

# قاعدة البيانات
# اتركه فارغاً للتجربة المحلية (سيستخدم ملف SQLite تلقائياً)
# للإنتاج ضع رابط PostgreSQL من Neon، مثال:
# DATABASE_URL=postgresql://user:pass@host.neon.tech/nashmi?sslmode=require
DATABASE_URL=

# مسار ملف SQLite في وضع التجربة المحلية
SQLITE_PATH=./db/nashmi.db

# ===== مزود رسائل OTP =====
# dev      = يطبع الرمز في سجل الخادم ويعرضه على الشاشة (للتجربة فقط)
# whatsapp_link = الزبون بيبعت الرمز لرقم نشمي على واتساب (بدون قالب — الموصى به)
# whatsapp = نشمي بيبعت الرمز بقالب (بده توثيق نشاط تجاري)
# twilio / local = يحتاج بيانات المزود أدناه ولم يُفعّل بعد
SMS_PROVIDER=dev

# فترة المعاينة على الخادم: 1 = يظهر رمز التحقق على الشاشة
# ⚠️ احذفه قبل ما تفتح التطبيق للناس
OTP_DEV_SHOW=1

# فترة المعاينة: قبول الكباتن تلقائياً بدون مراجعة الإدارة
# ⚠️ احذفه قبل الإطلاق (بعد تجهيز لوحة الإدارة)
CAPTAIN_AUTO_APPROVE=1

# منطقة الخدمة: 1 = كل الأردن (للتجربة). احذفه لترجع الخدمة للكرك فقط
SERVICE_ALL_JORDAN=1

# رقم (أو أرقام مفصولة بفاصلة) المالك — يدخل لوحة الإدارة /admin كمدير عام
ADMIN_PHONES=07XXXXXXXX

# ===== واتساب (WhatsApp Cloud API) — لما SMS_PROVIDER=whatsapp =====
# ⚠️ رمز الوصول سرّي: حطه بـ Render بس، أبداً مش بـ GitHub
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_WABA_ID=
# للدخول بواتساب (SMS_PROVIDER=whatsapp_link):
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_NUMBER=962XXXXXXXXX   (اختياري — بنجيبه من Meta)
# احتياط SMS للي ما عنده واتساب — تلفون أندرويد برقمك:
# SMS_FALLBACK=android
# SMSGATE_USERNAME=
# SMSGATE_PASSWORD=
# اسم قالب المصادقة المعتمد بـ WhatsApp Manager ولغته
# WHATSAPP_TEMPLATE=nashmi_otp
# WHATSAPP_TEMPLATE_LANG=ar
# 0 إذا القالب ما فيه زر «نسخ الرمز»
# WHATSAPP_COPY_BUTTON=1

# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# ===== الخرائط =====
# مزود البحث عن العناوين والمسارات (قابل للتبديل)
MAP_TILES_URL=https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png
MAP_TILES_URL_DARK=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png
GEOCODER_URL=https://nominatim.openstreetmap.org
ROUTING_URL=https://router.project-osrm.org

# ---------------- الخرائط ----------------
# CARTO صارت تطلب مفتاح. بدونه منستخدم OpenStreetMap (مجاني، أسماء عربية).
# مفتاح CARTO مجاني حتى 5 مليون بلاطة بالشهر: https://carto.com/basemaps/apikey/
# (بتقدر تحطه كمان من لوحة الإدارة ← الإعدادات)
CARTO_API_KEY=

# ---------------- الإشعارات الفورية ----------------
# مفاتيح Web Push بتتولّد لحالها وبتنحفظ بقاعدة البيانات. اختياري تثبيتها هون:
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@nashmi.app
# تطبيقات المتجر (Google Play / App Store): محتوى ملف Service Account من Firebase (JSON أو Base64)
FCM_SERVICE_ACCOUNT=
